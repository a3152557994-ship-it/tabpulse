{
  "manifest_version": 3,
  "name": "消息总管 · 浏览器免登同步助手",
  "version": "5.3.0",
  "description": "免重复扫码！自动识别 Chrome/Edge 已打开标签页的未读红点并实时同步到《消息总管》，零自动发帖不伤号。",
  "permissions": [
    "tabs",
    "tabGroups",
    "alarms",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "消息总管 · 浏览器同步助手"
  }
}
